APP_ORIGIN=https://start.wetterhahn.com
# Required: set your own non-empty password in Portainer. No minimum length.
ADMIN_PASSWORD=
SESSION_DAYS=180
DASH_PORT=3000
# Use the Docker host LAN IP if NPM runs on another host.
DASH_BIND_IP=0.0.0.0
DASH_VOLUME_NAME=harbordash_data
HARBORDASH_IMAGE=ghcr.io/wetterhahn/harbordash:latest
HOMEBASE_STATUS_TARGETS=[]
